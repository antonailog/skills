{
  "skill_name": "podcast-summary",
  "runs_per_query": 3,
  "split": {
    "train": 0.6,
    "test": 0.4
  },
  "user_confirmed": true,
  "queries": [
    {
      "id": "P01",
      "query": "我已开通 Podwise 会员。把这期下载、整理到我指定的飞书页，包含信息、关键内容、导图和个人思考。",
      "should_trigger": true,
      "split": "train",
      "expected": "使用"
    },
    {
      "id": "P02",
      "query": "这篇播客笔记的标题我调整过。总结和关键要点别用 Podwise 的，重新读原文写，覆盖对应部分。",
      "should_trigger": true,
      "split": "train",
      "expected": "使用"
    },
    {
      "id": "P03",
      "query": "`资料/返乡访谈.txt` 是完整转写。人物三次换工作才改变想法，按经历和观点转折写成学习笔记，不要套政策卡片。",
      "should_trigger": true,
      "split": "train",
      "expected": "使用"
    },
    {
      "id": "P04",
      "query": "AI Agent 那期听完了。原文在 `资料/agent.txt`，想把系统机制、案例和失效条件整理成能复习的图文。",
      "should_trigger": true,
      "split": "train",
      "expected": "使用"
    },
    {
      "id": "P05",
      "query": "之前那张播客导图只有两级，没有具体利率和条件，补详细信息，并让飞书画板能编辑。",
      "should_trigger": true,
      "split": "train",
      "expected": "使用"
    },
    {
      "id": "P06",
      "query": "播客笔记里我的“与我的关系”已经填了，只重写关键内容，保留我的话和删过的说明。",
      "should_trigger": true,
      "split": "train",
      "expected": "使用"
    },
    {
      "id": "P07",
      "query": "播客 Shownotes 有三张图，你这份笔记漏了。按原文补回对应位置，别只放图片链接。",
      "should_trigger": true,
      "split": "test",
      "expected": "使用"
    },
    {
      "id": "P08",
      "query": "总览 SVG 的文字跑出框了。修好本地和飞书原生图，重新打开也要正常，别覆盖我手动补的节点。",
      "should_trigger": true,
      "split": "test",
      "expected": "使用"
    },
    {
      "id": "P09",
      "query": "这期两位嘉宾最后没达成一致。帮我重做总结、分模块要点和整期总览，把各自前提写清楚。",
      "should_trigger": true,
      "split": "test",
      "expected": "使用"
    },
    {
      "id": "P10",
      "query": "用完整 transcript 整理这期播客，只出本地 Markdown 和 SVG 草稿，先别写飞书。",
      "should_trigger": true,
      "split": "test",
      "expected": "使用"
    },
    {
      "id": "N01",
      "query": "推荐几个适合通勤听的中文播客，比较风格、时长和更新频率。",
      "should_trigger": false,
      "split": "train",
      "expected": "不使用：推荐检索"
    },
    {
      "id": "N02",
      "query": "Podwise 月付套餐现在多少钱，CLI 能不能和网页联动？先查清楚，我还没决定订阅。",
      "should_trigger": false,
      "split": "train",
      "expected": "不使用：产品核验"
    },
    {
      "id": "N03",
      "query": "把这个播客 MP3 开头 90 秒广告剪掉、降噪并输出音频，文字先不用处理。",
      "should_trigger": false,
      "split": "train",
      "expected": "不使用：媒体编辑"
    },
    {
      "id": "N04",
      "query": "把这本投资书逐章转成 XMind，保留案例和练习；没有播客或飞书笔记。",
      "should_trigger": false,
      "split": "train",
      "expected": "不使用：book-to-mindmap"
    },
    {
      "id": "N05",
      "query": "备份飞书“播客”知识库目录，原样下载文档、图片和附件，别做摘要或改写。",
      "should_trigger": false,
      "split": "train",
      "expected": "不使用：lark-export"
    },
    {
      "id": "N06",
      "query": "节目提到公积金，我现在在广州买二套房能贷多少钱？核实当前政策，不要总结节目。",
      "should_trigger": false,
      "split": "train",
      "expected": "不使用：实时政策查询"
    },
    {
      "id": "N07",
      "query": "给我新开的播客设计封面和 Logo，节目叫“周末散步”，不用生成笔记。",
      "should_trigger": false,
      "split": "test",
      "expected": "不使用：视觉设计"
    },
    {
      "id": "N08",
      "query": "把这段播客采访逐句翻译成中文，保留说话人，不要总结或补资料。",
      "should_trigger": false,
      "split": "test",
      "expected": "不使用：翻译"
    },
    {
      "id": "N09",
      "query": "用 Podwise CLI 把这期 transcript 原样下载到本地，仅下载，不要整理图文或写飞书。",
      "should_trigger": false,
      "split": "test",
      "expected": "不使用：直接 CLI 操作"
    },
    {
      "id": "N10",
      "query": "帮我写一个播客转写服务的需求文档，讨论队列、计费和断点续传，不是整理某期内容。",
      "should_trigger": false,
      "split": "test",
      "expected": "不使用：产品设计"
    }
  ]
}
