# Secrets & local config — never commit
**/config/config.yaml
.env
*.local

# Python
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# Node
node_modules/

# Runtime / generated data
**/output/
# 宣传样例的产物要进仓库，只放行 examples 下的 output（2026-10-22）
!skills/*/examples/*/output/
**/downloads/
**/cache/
*_state.json

# OS
.DS_Store

# human-writing 的范文是别人的文章全文，只留本机，仓库里只放原文链接（2026-11-05）
skills/human-writing/references/范文/*
!skills/human-writing/references/范文/README.md
