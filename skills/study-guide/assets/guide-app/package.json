{
  "name": "study-guide-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "python3 -I scripts/build_guide.py && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "python3 -I scripts/build_guide.py && tsc --noEmit && vite build",
    "build:blog": "python3 -I scripts/build_guide.py && tsc --noEmit && vite build --mode blog",
    "example": "GUIDE_DIR=example npm run build:blog && GUIDE_DIR=example npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "0.577.0",
    "mermaid": "11.17.2",
    "radix-ui": "^1.8.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.2.1"
  }
}
